# ── Database ──────────────────────────────────────────────
# Local (SQLite) — keep for dev:
# DATABASE_URL="file:./dev.db"
#
# Production (Neon PostgreSQL) — get from Neon Console:
# DATABASE_URL="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/betaabinary?sslmode=require"
# DATABASE_URL_UNPOOLED="postgresql://user:pass@ep-xxxx.us-east-2.aws.neon.tech/betaabinary?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-random-string"
NEXTAUTH_URL="http://localhost:3000"
# In Vercel, set NEXTAUTH_URL to your production domain

# ── M-Pesa via Safaricom Daraja API ───────────────────────
# Get credentials from https://developer.safaricom.co.ke
MPESA_ENV=sandbox                                # "sandbox" or "production"
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey                       # From your Daraja app
MPESA_SHORTCODE=your_shortcode                   # Paybill / head-office shortcode
MPESA_TILL_NUMBER=your_till_number               # Required for CustomerBuyGoodsOnline
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline     # CustomerPayBillOnline | CustomerBuyGoodsOnline
MPESA_CALLBACK_URL=https://yourdomain.com/api/payments/mpesa/callback
USD_TO_KES=130

# ── Crypto USDT TRC20 Deposits ──────────────────────────
CRYPTO_USDT_ADDRESS=your_trc20_wallet_address
CRYPTO_AUTO_CONFIRM=false

# ── Vercel / Next.js ─────────────────────────────────────
# NEXT_PUBLIC_SITE_URL=https://yourdomain.com
